# Copy to .env.
#
# Zero-setup local database (recommended for the demo):
#   terminal 1: npm run db:dev     → embedded PostgreSQL 18 on 127.0.0.1:5433
#   terminal 2: npm run db:push    → create the tables from src/db/schema.ts
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/app_db

# Point this at any PostgreSQL 14+ server instead (Neon, RDS, on-prem) for a
# hosted deployment — the app only needs the connection string.
